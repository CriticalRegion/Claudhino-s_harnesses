{
  "extraKnownMarketplaces": {
    "ponytail": {
      "source": {
        "source": "github",
        "repo": "DietrichGebert/ponytail",
        "ref": "v5.3.3"
      }
    }
  },
  "enabledPlugins": {
    "ponytail@ponytail": true
  },
  "model": "sonnet",
  "permissions": {
    "allow": [
      "Bash(git *)",
      "Bash(npm *)",
      "Bash(npx *)",
      "Bash(pnpm *)",
      "Bash(node *)",
      "Bash(python3 *)",
      "Bash(ls *)",
      "Bash(grep *)",
      "Bash(curl localhost*)",
      "Bash(curl http://localhost*)",
      "Bash(curl -s http://localhost*)",
      "Bash(curl http://127.0.0.1*)",
      "Bash(bash .hackathon/bin/hk.sh *)",
      "mcp__context7",
      "mcp__playwright"
    ],
    "ask": [
      "Bash(git reset --hard*)",
      "Bash(git clean *)",
      "Bash(git checkout -- *)",
      "Bash(git restore *)",
      "Bash(git branch -D *)",
      "Bash(bash .hackathon/bin/hk.sh auto on*)",
      "Bash(bash .hackathon/bin/hk.sh solo @*)"
    ],
    "deny": [
      "Read(**/node_modules/**)",
      "Read(**/.next/**)",
      "Read(**/dist/**)",
      "Read(**/build/**)",
      "Read(package-lock.json)",
      "Read(pnpm-lock.yaml)",
      "Read(yarn.lock)",
      "Read(bun.lock)",
      "Read(.env)",
      "Read(.env.local)",
      "Read(.env.*.local)",
      "Read(.env.production)",
      "Bash(cat .env*)",
      "Bash(head .env*)",
      "Bash(tail .env*)",
      "Bash(less .env*)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push * --force*)",
      "Bash(git push * -f*)",
      "Bash(git push *+*)",
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~*)",
      "Read(**/*.pem)",
      "Read(**/id_rsa*)",
      "Read(**/.npmrc)",
      "Read(**/.dev.vars)",
      "Bash(git push * --no-verify*)",
      "Bash(git push --no-verify*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/clock.sh\"",
            "timeout": 10,
            "shell": "bash"
          }
        ]
      },
      {
        "matcher": "startup|resume|clear",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.hackathon/bin/hk.sh\" sync --hook",
            "timeout": 60,
            "shell": "bash"
          },
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.hackathon/bin/hk.sh\" watch",
            "asyncRewake": true,
            "timeout": 3600,
            "shell": "bash"
          }
        ]
      },
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/hh.js\" start",
            "timeout": 10,
            "shell": "bash"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/clock.sh\" --quiet-unless-late",
            "timeout": 10,
            "shell": "bash"
          },
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.hackathon/bin/hk.sh\" peek",
            "timeout": 10,
            "shell": "bash"
          },
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/hh.js\" prompt",
            "timeout": 5,
            "shell": "bash"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.hackathon/bin/hk.sh\" posttool",
            "timeout": 10,
            "shell": "bash"
          },
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/hh.js\" post",
            "timeout": 10,
            "shell": "bash"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|Edit|Write|MultiEdit|NotebookEdit|Read|mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/hh.js\" guard",
            "timeout": 10,
            "shell": "bash"
          }
        ]
      },
      {
        "matcher": "Edit|Write|NotebookEdit|AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.hackathon/bin/hk.sh\" pretool",
            "timeout": 10,
            "shell": "bash"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/hh.js\" stop",
            "timeout": 120,
            "shell": "bash"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.hackathon/bin/hk.sh\" autostop",
            "timeout": 10,
            "shell": "bash"
          },
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.hackathon/bin/hk.sh\" watch",
            "asyncRewake": true,
            "timeout": 3600,
            "shell": "bash"
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.hackathon/bin/hk.sh\" permit",
            "timeout": 10,
            "shell": "bash"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/hh.js\" precompact",
            "timeout": 15,
            "shell": "bash"
          }
        ]
      }
    ]
  },
  "env": {
    "CLAUDE_AUTOCOMPACT_PCT_OVERRIDE": "75"
  },
  "statusLine": {
    "type": "command",
    "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/hh.js\" statusline",
    "padding": 0
  }
}
