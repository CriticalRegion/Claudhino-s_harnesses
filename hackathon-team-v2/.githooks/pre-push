#!/usr/bin/env bash
# Keep main demoable: a push to main/master must pass `npm run check` (if package.json defines it).
# Other branches push freely. Bypass in an emergency: HK_SKIP=1 git push
[ -n "${HK_SKIP:-}" ] && exit 0
protect=0
while read -r _lref lsha rref _rsha; do
  case $rref in refs/heads/main|refs/heads/master)
    case $lsha in *[!0]*) protect=1;; esac;;   # all zeros = branch delete
  esac
done
[ $protect = 1 ] || exit 0
cd "$(git rev-parse --show-toplevel)" || exit 0
[ -f package.json ] || exit 0
grep -q '"check"[[:space:]]*:' package.json || exit 0
echo "pre-push: npm run check (main must stay demoable; HK_SKIP=1 git push to bypass)" >&2
npm run -s check || { echo "pre-push: check failed, push to main blocked." >&2; exit 1; }
